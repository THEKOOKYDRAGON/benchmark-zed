# .github/workflows/passmark-cpu-benchmark.yml
#
# Measures the PassMark CPU_SINGLETHREAD score — the exact metric the RunsOn
# leaderboard uses — so your number is directly comparable to the board.
# Runs the same test on your Monk CI runner AND on ubuntu-latest (GitHub's
# baseline) in one go, so you can see the gap side by side.
#
# HOW TO USE:
#   1. Commit this file to .github/workflows/ in any repo in your org.
#   2. Go to the repo's "Actions" tab → "PassMark CPU Benchmark" → "Run workflow".
#   3. Open each job's log and read the CPU_SINGLETHREAD line at the end.
#   4. Run it a few times and take the MEDIAN — cloud CPU scores are noisy,
#      and the leaderboard reports a p50 over 30 days, not a single run.

name: PassMark CPU Benchmark

on:
  workflow_dispatch: {}   # run manually from the Actions tab

jobs:
  benchmark:
    strategy:
      fail-fast: false
      matrix:
        # 👇 Replace the first entry with YOUR Monk CI 2-vCPU label.
        #    Keep it at 2 vCPU — that's the standard comparison tier on the board.
        runner:
          - monkci-ubuntu-24.04-2
          - ubuntu-latest
    runs-on: ${{ matrix.runner }}
    name: passmark-${{ matrix.runner }}
    steps:
      - name: Note start time (rough sense of cold-start / queue)
        run: echo "Job started at $(date -u +%H:%M:%S) UTC on ${{ matrix.runner }}"

      - name: Install PassMark dependencies
        run: |
          sudo apt-get update -y
          # PassMark needs the legacy ncurses libs. On Ubuntu 24.04 these live in
          # the 'universe' component; enable it if the install fails.
          sudo apt-get install -y unzip wget libncurses5 libtinfo5 \
            || (sudo add-apt-repository -y universe && sudo apt-get update -y \
                && sudo apt-get install -y unzip wget libncurses5 libtinfo5)

      - name: Download PassMark PerformanceTest (Linux x64)
        run: |
          # If this URL ever 404s, grab the current link from:
          #   https://www.passmark.com/products/pt_linux/download.php
          wget -q https://www.passmark.com/downloads/pt_linux_x64.zip
          unzip -q pt_linux_x64.zip

      - name: Run CPU tests
        run: |
          cd PerformanceTest
          chmod +x pt_linux_x64
          # -r 1   : CPU tests only
          # -d 3   : long duration (more stable score)
          # -debug : run headless and skip the upload prompt
          ./pt_linux_x64 -r 1 -d 3 -debug

      - name: Print the single-thread score (compare this to the leaderboard)
        run: |
          cd PerformanceTest
          echo "================ FULL CPU RESULTS ================"
          cat results_all.yml 2>/dev/null || cat results_cpu.yml 2>/dev/null || true
          echo "=================================================="
          echo ">>> The number that matches the RunsOn 'CPU speed' column:"
          grep -i "CPU_SINGLETHREAD" results_all.yml 2>/dev/null \
            || grep -i "CPU_SINGLETHREAD" results_cpu.yml 2>/dev/null \
            || echo "CPU_SINGLETHREAD not found — check the full results above for the filename."

      # ARM RUNNERS: if you also offer arm64, duplicate this workflow and swap
      # pt_linux_x64 -> pt_linux_arm64 (and the matching .zip), then compare
      # against the leaderboard's separate arm64 board.
